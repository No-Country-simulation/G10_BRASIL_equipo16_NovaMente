# Copie para frontend/.env (não commitar o .env).

# mock = usa as fixtures em frontend/fixtures, sem IA nem modelo (ideal para desenvolver a tela)
# ia   = chama a ai_stack real (precisa do requirements.txt da raiz e da GROQ_API_KEY no .env da raiz)
NOVAMENTE_MODO=mock

# Tamanho máximo de upload em MB (o Streamlit também respeita .streamlit/config.toml)
NOVAMENTE_MAX_UPLOAD_MB=10
